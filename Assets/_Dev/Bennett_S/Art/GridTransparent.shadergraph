{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9cafe0cecd6447308345db8e329308ef",
    "m_Title": "Grid Auto-Scaling",
    "m_Content": "Multiplies by the default scale, then multiplies again against the desired tile size to avoid division (more performant to do multiplication since the shader will be running a lot). It then is divided in half to ensure X and Y Size reflect direct tile lengths, such as 10 on the X equalling 10 tiles.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1969.0,
        "y": 2.0,
        "width": 1019.5685424804688,
        "height": 464.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

